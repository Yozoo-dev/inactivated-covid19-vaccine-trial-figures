 library(tidyverse)
library(RColorBrewer)

#========================
# 1. 数据输入
#========================
df <- data.frame(
  Year = c(
    2020,2020,
    2021,2021,2021,2021,2021,
    2022,2022,2022,2022,
    2023,2023,2023,
    2024,2024,
    2025
  ),
  Status = c(
    "Completed","Unknown status",
    "Completed","Suspended","Terminated","Unknown status","Withdrawn",
    "Completed","Temporarily Closed","Unknown status","Withdrawn",
    "Completed","Terminated","Unknown status",
    "Active, not recruiting","Unknown status",
    "Withdrawn"
  ),
  Number = c(
    17,2,
    22,1,1,19,1,
    11,1,18,3,
    2,1,5,
    1,3,
    1
  )
)

#========================
# 2. 因子排序（SCI规范）
#========================
df$Status <- factor(df$Status, levels = c(
  "Completed",
  "Active, not recruiting",
  "Temporarily Closed",
  "Unknown status",
  "Suspended",
  "Terminated",
  "Withdrawn"
))

#========================
# 3. 光谱色阶（Spectral）
#========================
cols <- rev(colorRampPalette(
  brewer.pal(11, "Spectral")
)(100))

#========================
# 4. SCI桑葚气泡图
#========================

p <- ggplot(df, aes(
  x = factor(Year),
  y = Status
)) +

  geom_point(
    aes(
      size = Number,
      fill = Number
    ),
    shape = 21,
    color = "black",
    stroke = 0.5,
    alpha = 0.95
  ) +

  geom_text(
    aes(label = Number),
    size = 4,
    fontface = "bold"
  ) +

  scale_fill_gradientn(
    colours = cols,
    name = "Number"
  ) +

  scale_size_continuous(
    range = c(3, 18),
    name = "Number"
  ) +

  labs(
    title = "Temporal Distribution of Study Status",
    x = "Year First Posted",
    y = "Study Status"
  ) +

  theme_minimal(base_size = 15) +

  theme(
    plot.title = element_text(
      face = "bold",
      hjust = 0.5,
      size = 18
    ),
    axis.text = element_text(
      face = "bold",
      color = "black"
    ),
    panel.grid.major = element_line(color = "grey90"),
    panel.grid.minor = element_blank(),
    legend.position = "right"
  )

#========================
# 5. 600 DPI导出
#========================
ggsave(
  "Mulberry_Bubble_Heatmap.tiff",
  plot = p,
  dpi = 600,
  width = 10,
  height = 6,
  compression = "lzw"
)

