df <- read.table(
  text = raw_text,
  header = FALSE,
  sep = "\t",
  col.names = c("Year", "Phase"),
  stringsAsFactors = FALSE,
  strip.white = TRUE
)

df$Year <- as.integer(df$Year)

# ============================================================
# 2. 设置年份和Phase顺序
# ============================================================

year_levels <- 2020:2025

phase_levels <- c(
  "I",
  "I/II",
  "II",
  "II/III",
  "III",
  "IV"
)

# ============================================================
# 3. 自动统计数量
# ============================================================

count_df <- as.data.frame(
  table(
    Year = factor(df$Year, levels = year_levels),
    Phase = factor(df$Phase, levels = phase_levels)
  )
)

colnames(count_df) <- c("Year", "Phase", "Count")

count_df$Year <- factor(
  count_df$Year,
  levels = year_levels
)

# 让Phase I位于图形最上方
count_df$Phase <- factor(
  count_df$Phase,
  levels = rev(phase_levels)
)

# 零值不参与光谱色阶，单独显示为浅灰色
count_df$FillCount <- ifelse(
  count_df$Count == 0,
  NA,
  count_df$Count
)

# 根据背景深浅自动改变文字颜色
count_df$TextColor <- ifelse(
  count_df$Count >= 8,
  "white",
  "#202020"
)

# 所有格子均标注n值
count_df$Label <- paste0("n=", count_df$Count)

# 查看统计结果
print(count_df[, c("Year", "Phase", "Count")])

# ============================================================
# 4. 光谱色阶
# ============================================================

spectrum_colors <- c(
  "#5E4FA2",
  "#3288BD",
  "#66C2A5",
  "#ABDDA4",
  "#E6F598",
  "#FFFFBF",
  "#FEE08B",
  "#FDAE61",
  "#F46D43",
  "#D53E4F",
  "#9E0142"
)

# ============================================================
# 5. 绘制热图
# ============================================================

p <- ggplot(
  count_df,
  aes(
    x = Year,
    y = Phase,
    fill = FillCount
  )
) +

  # 热图格子
  geom_tile(
    width = 0.93,
    height = 0.90,
    color = "white",
    linewidth = 1.2
  ) +

  # 标注每个格子的数量
  geom_text(
    aes(
      label = Label,
      color = TextColor
    ),
    size = 4.3,
    fontface = "bold",
    family = "sans",
    show.legend = FALSE
  ) +

  # 光谱色阶
  scale_fill_gradientn(
    colours = spectrum_colors,
    limits = c(1, max(count_df$Count)),
    breaks = c(1, 5, 10, 15, 20, 22),
    na.value = "#F1F1F1",
    name = "Number of\nstudies"
  ) +

  # 使用数据中指定的文字颜色
  scale_color_identity() +

  labs(
    x = "First Posted",
    y = "Phase"
  ) +

  # 保持热图格子比例协调
  coord_fixed(ratio = 0.78) +

  # SCI/Nature风格主题
  theme_minimal(base_family = "sans") +

  theme(
    # 不显示顶部标题
    plot.title = element_blank(),

    axis.title.x = element_text(
      size = 13,
      face = "bold",
      color = "#222222",
      margin = margin(t = 12)
    ),

    axis.title.y = element_text(
      size = 13,
      face = "bold",
      color = "#222222",
      margin = margin(r = 12)
    ),

    axis.text.x = element_text(
      size = 11.5,
      face = "bold",
      color = "#222222"
    ),

    axis.text.y = element_text(
      size = 11.5,
      face = "bold",
      color = "#222222"
    ),

    panel.grid = element_blank(),

    axis.ticks = element_blank(),

    legend.position = "right",

    legend.title = element_text(
      size = 10.5,
      face = "bold",
      color = "#222222",
      lineheight = 0.9
    ),

    legend.text = element_text(
      size = 9.5,
      color = "#333333"
    ),

    legend.key.height = grid::unit(0.72, "cm"),
    legend.key.width = grid::unit(0.38, "cm"),

    plot.background = element_rect(
      fill = "white",
      color = NA
    ),

    panel.background = element_rect(
      fill = "white",
      color = NA
    ),

    plot.margin = margin(
      t = 18,
      r = 25,
      b = 18,
      l = 18
    )
  )

# ============================================================
# 6. 在RStudio中直接显示
# ============================================================

print(p)

# ============================================================
# 7. 保存600 dpi投稿图片
# ============================================================

ggsave(
  filename = "First_Posted_Phase_Spectrum_Heatmap.tiff",
  plot = p,
  width = 8.5,
  height = 6.5,
  units = "in",
  dpi = 600,
  compression = "lzw",
  bg = "white"
)

# 保存PNG预览图
ggsave(
